---
import { site } from "../data/site";

interface Props {
  lang: "hu" | "en";
}

const { lang } = Astro.props;
const isHu = lang === "hu";
const applicationHref = isHu ? "/sorselemzes-jelentkezes/" : "/en/chart-reading-application/";
---

<section class="relative flex min-h-[calc(100vh-4rem)] items-center overflow-hidden bg-[radial-gradient(ellipse_at_50%_35%,#fff8ee_0%,#f3e8ff_55%,#fde9f5_100%)] py-20 text-center md:py-28">
  <div class="astro-orbit-system" aria-hidden="true">
    <div class="solar-core"></div>
    <div class="solar-orbit orbit-mercury" style="--orbit-size: 26%; --orbit-speed: 14s; --start: 24deg; --planet-size: 0.42rem; --planet-color: #b7a6c9;">
      <span class="solar-planet"></span>
    </div>
    <div class="solar-orbit orbit-venus" style="--orbit-size: 38%; --orbit-speed: 23s; --start: 144deg; --planet-size: 0.62rem; --planet-color: #d8a45a;">
      <span class="solar-planet"></span>
    </div>
    <div class="solar-orbit orbit-earth" style="--orbit-size: 50%; --orbit-speed: 32s; --start: 268deg; --planet-size: 0.66rem; --planet-color: #7558c0;">
      <span class="solar-planet"></span>
    </div>
    <div class="solar-orbit orbit-mars" style="--orbit-size: 61%; --orbit-speed: 48s; --start: 52deg; --planet-size: 0.54rem; --planet-color: #e0748e;">
      <span class="solar-planet"></span>
    </div>
    <div class="solar-orbit orbit-jupiter" style="--orbit-size: 75%; --orbit-speed: 76s; --start: 198deg; --planet-size: 1rem; --planet-color: #c9883a;">
      <span class="solar-planet"></span>
    </div>
    <div class="solar-orbit orbit-saturn" style="--orbit-size: 90%; --orbit-speed: 108s; --start: 318deg; --planet-size: 0.9rem; --planet-color: #e8b55a;">
      <span class="solar-planet solar-planet-ringed"></span>
    </div>
  </div>
  <div class="container-page relative z-10">
    <div class="hero-copy mx-auto max-w-3xl">
      <p class="eyebrow">{isHu ? "Önismeret asztrológiai szemlélettel" : "Self-awareness through astrology"}</p>
      <h1 class="section-title mt-6 text-lena-text">{site.nameHu}</h1>
      <p class="mt-5 text-lg font-normal leading-8 text-lena-deep md:text-xl">
        {isHu ? site.titleHu : site.titleEn}
      </p>
      <p class="mx-auto mt-6 max-w-[34rem] text-[1.05rem] leading-8 text-lena-soft">
        {
          isHu
            ? "Személyes, figyelmes kísérés azoknak, akik szeretnék jobban érteni saját működésüket, döntéseiket és élethelyzeteik mélyebb mintázatait."
            : "A personal, grounded space for people who want to understand their patterns, choices and life situations with more clarity."
        }
      </p>
      <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
        <a class="btn btn-primary" href={applicationHref}>
          {isHu ? "Jelentkezés sorselemzésre" : "Apply for a chart reading"}
        </a>
        <a class="btn btn-secondary" href={site.calendly} target="_blank" rel="noreferrer">
          {isHu ? "30 perces ingyenes hívás" : "Free 30-minute call"}
        </a>
      </div>
      <dl class="mx-auto mt-10 grid max-w-xl gap-3 text-sm sm:grid-cols-2">
        <div class="soft-panel bg-white/72 p-4">
          <dt class="text-xs font-medium uppercase tracking-[0.16em] text-lena-gold">{isHu ? "Díj" : "Fee"}</dt>
          <dd class="mt-1 font-display text-3xl font-light text-lena-text">30 000 Ft</dd>
        </div>
        <div class="soft-panel bg-white/72 p-4">
          <dt class="text-xs font-medium uppercase tracking-[0.16em] text-lena-gold">{isHu ? "Időtartam" : "Duration"}</dt>
          <dd class="mt-1 font-display text-3xl font-light text-lena-text">60 {isHu ? "perc" : "minutes"}</dd>
        </div>
      </dl>
    </div>
  </div>
</section>
