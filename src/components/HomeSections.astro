---
import { site } from "../data/site";

interface Props {
  lang: "hu" | "en";
}

const { lang } = Astro.props;
const isHu = lang === "hu";
const aboutId = isHu ? "rolam" : "about";
const focusId = isHu ? "fokusz" : "focus";
const contactId = isHu ? "kapcsolat" : "contact";
const applicationHref = isHu ? "/sorselemzes-jelentkezes/" : "/en/chart-reading-application/";
const focusItems = isHu
  ? [
      ["Önismereti mentorálás", "Támogatás abban, hogy tisztábban lásd a visszatérő belső mintákat és döntési helyzeteket."],
      ["Asztrológiai konzultáció", "A képleted személyes értelmezése közérthetően, fókuszált kérdésekkel és gyakorlati nézőpontokkal."],
      ["Személyes kísérés", "Figyelmes, bizalmi tér, ahol a saját tempódban lehet ránézni a következő lépésre."],
    ]
  : [
      ["Self-awareness mentoring", "Support for seeing recurring inner patterns and decision points with more clarity."],
      ["Astrological consultation", "A personal reading of your chart in clear language, with focused questions and practical perspective."],
      ["Personal guidance", "A calm, confidential space to look at your next step at your own pace."],
    ];

const socialIcons = {
  instagram: '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.6" y="3.6" width="16.8" height="16.8" rx="5.1"></rect><circle cx="12" cy="12" r="3.7"></circle><circle cx="17.2" cy="6.8" r="0.9"></circle></svg>',
  tiktok: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.2 4v10.15a4.35 4.35 0 1 1-4.35-4.35c.34 0 .67.04.98.12v3.06a1.62 1.62 0 1 0 1.07 1.52V4h2.3c.37 2.1 1.72 3.7 3.8 4.18v2.96a6.76 6.76 0 0 1-3.8-1.28Z"></path></svg>',
  facebook: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.2 8.2V6.85c0-.65.43-.8.73-.8h1.86V3.2l-2.56-.01c-2.84 0-3.49 2.13-3.49 3.49V8.2H8.5v2.94h2.24v9.66h3.46v-9.66h2.33l.31-2.94Z"></path></svg>',
};
---

<section id={aboutId} class="bg-lena-bg py-24">
  <div class="container-page grid gap-10 md:grid-cols-[0.85fr_1.15fr] md:items-center">
    <div>
      <p class="eyebrow">{isHu ? "Rólam" : "About"}</p>
      <h2 class="section-heading mt-4 text-lena-text">
        {isHu ? <>Finom figyelem,<br /><em>tiszta kérdések.</em></> : <>Gentle attention,<br /><em>clear questions.</em></>}
      </h2>
      <div class="mt-8 h-px w-14 bg-gradient-to-r from-lena-gold to-lena-goldLight"></div>
    </div>
    <p class="text-[1.05rem] leading-9 text-lena-soft">
      {
        isHu
          ? "Léna önismereti mentorként és asztrológusként dolgozik. A konzultációk célja nem kész válaszok átadása, hanem olyan nézőpontok megnyitása, amelyek segítenek közelebb kerülni a saját működésedhez, erőforrásaidhoz és aktuális élethelyzetedhez."
          : "Léna works as a self-awareness mentor and astrologer. Her consultations are not about handing out fixed answers, but about opening perspectives that help you get closer to your own patterns, resources and current life situation."
      }
    </p>
  </div>
</section>

<section id={focusId} class="bg-lena-lilac py-24">
  <div class="container-page">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow">{isHu ? "Fókuszterületek" : "Focus areas"}</p>
      <h2 class="section-heading mt-4 text-lena-text">
        {isHu ? <>A konzultáció <em>rólad</em> és a kérdésedről szól.</> : <>The consultation centers on <em>you</em> and your question.</>}
      </h2>
      <div class="mx-auto mt-8 h-px w-14 bg-gradient-to-r from-lena-gold to-lena-goldLight"></div>
    </div>
    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {focusItems.map(([title, text]) => (
        <article class="soft-panel p-7 transition duration-300 hover:-translate-y-1 hover:border-lena-gold hover:shadow-[0_12px_40px_rgba(201,136,58,0.14)]">
          <h3 class="font-display text-[1.7rem] font-normal leading-tight text-lena-text">{title}</h3>
          <p class="mt-4 leading-8 text-lena-soft">{text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section id={contactId} class="bg-lena-peach py-24">
  <div class="container-page grid gap-8 lg:grid-cols-[0.95fr_1.05fr]">
    <div>
      <p class="eyebrow">{isHu ? "Kapcsolat" : "Contact"}</p>
      <h2 class="section-heading mt-4 text-lena-text">
        {isHu ? <>Válaszd ki,<br /><em>hogyan induljunk.</em></> : <>Choose how you would<br /><em>like to begin.</em></>}
      </h2>
      <p class="mt-6 max-w-xl leading-8 text-lena-soft">
        {
          isHu
            ? "Ha már tudod, hogy sorselemzésre jelentkeznél, küldd el az adataidat. Ha előbb ismerkednél, foglalj egy rövid, ingyenes hívást."
            : "If you already know you would like a chart reading, send your details. If you would prefer to connect first, book a short free call."
        }
      </p>
      <div class="mt-7 flex flex-col gap-3 sm:flex-row">
        <a class="btn btn-primary" href={applicationHref}>
          {isHu ? "Jelentkezés sorselemzésre" : "Apply for a chart reading"}
        </a>
        <a class="btn btn-secondary" href={site.calendly} target="_blank" rel="noreferrer">
          {isHu ? "30 perces ingyenes hívás" : "Free 30-minute call"}
        </a>
      </div>
    </div>
    <div class="soft-panel self-start p-6 md:p-7">
      <div class="space-y-5 text-lena-soft">
        <div>
          <p class="text-xs font-medium uppercase tracking-[0.18em] text-lena-gold">{isHu ? "Elérhetőségek" : "Details"}</p>
          <div class="mt-3 space-y-2 text-[1.02rem]">
            <a class="block transition hover:text-lena-gold" href={`mailto:${site.email}`}>{site.email}</a>
            <a class="block transition hover:text-lena-gold" href={`tel:${site.phoneMachine}`}>{site.phone}</a>
          </div>
        </div>
        <div>
          <p class="text-xs font-medium uppercase tracking-[0.18em] text-lena-gold">{isHu ? "Platformok" : "Platforms"}</p>
          <div class="mt-3 flex gap-3">
        {site.socials.map((social) => (
          <a class="social-icon-link" href={social.href} target="_blank" rel="noreferrer" aria-label={social.label} title={social.label}>
            <span set:html={socialIcons[social.id]} />
          </a>
        ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
