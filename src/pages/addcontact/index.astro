---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../data/site";
---

<BaseLayout
  lang="hu"
  title={`Névjegy mentése | ${site.nameHu}`}
  description="Kelecsényi Léna névjegyének mentése telefonra."
>
  <section class="bg-[radial-gradient(ellipse_at_50%_35%,#fff8ee_0%,#f3e8ff_55%,#fde9f5_100%)] py-16 md:py-24">
    <div class="container-page max-w-3xl">
      <div class="soft-panel p-6 md:p-10">
        <p class="eyebrow">Névjegy</p>
        <h1 class="section-heading mt-4 text-lena-text">
          {site.nameHu}
        </h1>
        <p class="mt-4 text-xl font-normal text-lena-deep">{site.titleHu}</p>
        <div class="mt-8 grid gap-3 text-lena-soft">
          <a class="rounded-md border border-[var(--border)] bg-[#faf8ff] p-4" href={`mailto:${site.email}`}>{site.email}</a>
          <a class="rounded-md border border-[var(--border)] bg-[#faf8ff] p-4" href={`tel:${site.phoneMachine}`}>{site.phone}</a>
          {site.socials.map((social) => (
            <a class="rounded-md border border-[var(--border)] bg-[#faf8ff] p-4" href={social.href} target="_blank" rel="noreferrer">
              {social.label}
            </a>
          ))}
        </div>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a class="btn btn-primary" href="/contact.vcf" download>Névjegy mentése telefonra</a>
          <a class="btn btn-secondary" href="/">Weboldal megnyitása</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
